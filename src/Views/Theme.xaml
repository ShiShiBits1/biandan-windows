<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero">
 <SolidColorBrush x:Key="Ink" Color="{DynamicResource ThemeColor2E2418}"/><SolidColorBrush x:Key="Muted" Color="{DynamicResource ThemeColor79684F}"/><SolidColorBrush x:Key="Accent" Color="{DynamicResource ThemeColorFFB639}"/><SolidColorBrush x:Key="AccentLight" Color="{DynamicResource ThemeColorFFF0CC}"/><SolidColorBrush x:Key="Line" Color="{DynamicResource ThemeColorEFE1C8}"/>
 <LinearGradientBrush x:Key="FrostedFill" StartPoint=".18,0" EndPoint=".86,1" Opacity=".96">
  <GradientStop Color="#FFFFFF" Offset="0"/>
  <GradientStop Color="{DynamicResource ThemeColorFFFDF8}" Offset=".47"/>
  <GradientStop Color="{DynamicResource ThemeColorFFF3DB}" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="FrostedRim" StartPoint=".18,0" EndPoint=".82,1">
  <GradientStop Color="#FFFFFF" Offset="0"/>
  <GradientStop Color="{DynamicResource ThemeColorFFE2A2}" Offset=".43"/>
  <GradientStop Color="{DynamicResource ThemeColorE5D0AA}" Offset="1"/>
 </LinearGradientBrush>
 <DrawingBrush x:Key="FrostedGrain" TileMode="Tile" Viewport="0,0,11,9" ViewportUnits="Absolute" Viewbox="0,0,11,9" ViewboxUnits="Absolute">
  <DrawingBrush.Drawing>
   <GeometryDrawing Brush="#08513D24" Geometry="M1,2h1v1h-1z M7,5h1v1h-1z M4,8h1v1h-1z"/>
  </DrawingBrush.Drawing>
 </DrawingBrush>
 <Style x:Key="FrostedCard" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource FrostedFill}"/>
  <Setter Property="BorderBrush" Value="{StaticResource FrostedRim}"/>
  <Setter Property="BorderThickness" Value="1"/>
 </Style>
 <Style x:Key="FrostedBackdrop" TargetType="Control">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="IsHitTestVisible" Value="False"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Control">
    <Grid SnapsToDevicePixels="True">
     <themes:SystemDropShadowChrome Color="#38544635" Margin="-2,-1,2,1" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"/>
     <Border Style="{StaticResource FrostedCard}" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"/>
     <Border Margin="1" BorderThickness="1,1,0,0" BorderBrush="#BDFFFFFF" Background="{StaticResource FrostedGrain}"
      CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"/>
    </Grid>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{DynamicResource ThemeBrushFFF3DB}"/></Style>
 <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource ThemeBrush2E2418}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="Button" x:Key="BaseButton">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><Grid><Border x:Name="Halo" CornerRadius="9" IsHitTestVisible="False" Opacity="0"><Border.Background><RadialGradientBrush GradientOrigin="0.45,0" Center="0.45,0" RadiusX="0.85" RadiusY="1.2"><GradientStop Color="{DynamicResource ThemeColor7AFFD888}" Offset="0"/><GradientStop Color="{DynamicResource ThemeColor00FFE8B8}" Offset="1"/></RadialGradientBrush></Border.Background></Border><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Halo" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Halo" Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ThemeBrush8D560B}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
 <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="20,11"/></Style>
 <Style TargetType="Button" x:Key="Secondary" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="{DynamicResource ThemeBrushFFFDF7}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
 <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource BaseButton}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
 <Style TargetType="Button" x:Key="PlanningButton" BasedOn="{StaticResource BaseButton}">
  <Setter Property="Padding" Value="11,6"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <Grid>
       <Border x:Name="Hover" CornerRadius="7" IsHitTestVisible="False" Background="{TemplateBinding Foreground}" Opacity="0"/>
       <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.16"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.48"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="PlanningScrollbar" TargetType="ScrollBar">
  <Setter Property="Width" Value="11"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Track x:Name="PART_Track" IsDirectionReversed="True" Width="9" HorizontalAlignment="Center">
      <Track.DecreaseRepeatButton>
       <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
       </RepeatButton>
      </Track.DecreaseRepeatButton>
      <Track.Thumb>
       <Thumb>
        <Thumb.Template>
         <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbSurface" Background="{DynamicResource ThemeBrushA89570}" Opacity="0.68" CornerRadius="3" Margin="2,1" MinHeight="14"/>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger>
           <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </Thumb.Template>
       </Thumb>
      </Track.Thumb>
      <Track.IncreaseRepeatButton>
       <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
       </RepeatButton>
      </Track.IncreaseRepeatButton>
     </Track>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Background" Value="{DynamicResource ThemeBrushFFFDF7}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBrushEDDFC5}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{DynamicResource ThemeBrushFFE2A2}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ThemeBrushCE8B24}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="19" Height="19" CornerRadius="6" BorderThickness="1.4" BorderBrush="{DynamicResource ThemeBrushDCC699}" Background="Transparent" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource AccentInk}" Visibility="Collapsed"/></Border><ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeBrushC88A20}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PickerToggle" TargetType="ToggleButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border Background="Transparent" CornerRadius="9"/>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="PickerItem" TargetType="ComboBoxItem">
  <Setter Property="Padding" Value="10,7"/>
  <Setter Property="Margin" Value="0,1"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="OptionRow" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
      <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionRow" Property="Background" Value="{DynamicResource ThemeBrushFFE2A2}"/></Trigger>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionRow" Property="Background" Value="{DynamicResource ThemeBrushFFF0CA}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="OptionRow" Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="Background" Value="{DynamicResource ThemeBrushFFFDF7}"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrushEDDFC5}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="11,7"/>
  <Setter Property="MinHeight" Value="38"/>
  <Setter Property="MaxDropDownHeight" Value="280"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid x:Name="PickerRoot">
      <Border x:Name="PickerFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="29"/></Grid.ColumnDefinitions>
       <ContentPresenter x:Name="CurrentSelection" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
        Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
       <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent" BorderThickness="0" MinHeight="0" IsReadOnly="{TemplateBinding IsReadOnly}" Padding="{TemplateBinding Padding}"/>
       <Path Grid.Column="1" Data="M 1,2 L 5,6 L 9,2" Stroke="{DynamicResource ThemeBrush79684F}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
       <ToggleButton x:Name="PickerTrigger" Grid.ColumnSpan="2" Style="{StaticResource PickerToggle}" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
      </Grid>
      <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-4" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
       <Border x:Name="PickerOptions" Margin="4,4,7,8" CornerRadius="11"
        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
        <Grid>
         <Control Style="{StaticResource FrostedBackdrop}"/>
         <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Grid>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PickerFrame" Property="BorderBrush" Value="{DynamicResource ThemeBrushDBB779}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PickerFrame" Property="BorderBrush" Value="{DynamicResource ThemeBrushCE8B24}"/></Trigger>
      <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="PickerFrame" Property="BorderBrush" Value="{DynamicResource ThemeBrushCE8B24}"/></Trigger>
      <Trigger Property="IsEditable" Value="True">
       <Setter TargetName="CurrentSelection" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
       <Setter TargetName="PickerTrigger" Property="Grid.Column" Value="1"/>
       <Setter TargetName="PickerTrigger" Property="Grid.ColumnSpan" Value="1"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PickerRoot" Property="Opacity" Value="0.48"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="CalendarCell" TargetType="Button">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="MinWidth" Value="28"/>
  <Setter Property="MinHeight" Value="24"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Button">
    <Border CornerRadius="6" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
   </ControlTemplate>
  </Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeBrushFFF0CA}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="PickerCalendar" TargetType="Calendar">
  <Setter Property="CalendarDayButtonStyle">
   <Setter.Value><Style TargetType="CalendarDayButton" BasedOn="{StaticResource CalendarCell}">
    <Style.Triggers>
     <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
     <Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThemeBrushCE8B24}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value=".42"/></Trigger>
    </Style.Triggers>
   </Style></Setter.Value>
  </Setter>
  <Setter Property="CalendarButtonStyle">
   <Setter.Value><Style TargetType="CalendarButton" BasedOn="{StaticResource CalendarCell}">
    <Setter Property="MinWidth" Value="45"/>
    <Setter Property="MinHeight" Value="34"/>
    <Style.Triggers>
     <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
     <Trigger Property="HasSelectedDays" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeBrushFFE2A2}"/></Trigger>
    </Style.Triggers>
   </Style></Setter.Value>
  </Setter>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Calendar">
     <StackPanel x:Name="PART_Root">
      <Border x:Name="CalendarSurface" Margin="4,4,7,8" CornerRadius="11">
       <Grid>
        <Control Style="{StaticResource FrostedBackdrop}"/>
        <CalendarItem x:Name="PART_CalendarItem" Margin="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
         Style="{TemplateBinding CalendarItemStyle}"/>
       </Grid>
      </Border>
     </StackPanel>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="DatePicker">
  <Setter Property="Background" Value="{DynamicResource ThemeBrushFFFDF7}"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrushEDDFC5}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="MinHeight" Value="38"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="SelectedDateFormat" Value="Short"/>
  <Setter Property="CalendarStyle" Value="{StaticResource PickerCalendar}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DatePicker">
     <Grid x:Name="DateRoot">
      <Border x:Name="DateFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
       <Grid Margin="5,0,3,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Padding="6,0,2,0" VerticalContentAlignment="Center"/>
        <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource IconButton}" Height="30" ToolTip="选择日期" AutomationProperties.Name="选择日期">
         <Path Data="M1,3 H13 V13 H1 Z M1,6 H13 M4,1 V4 M10,1 V4 M4,9 H6 M8,9 H10"
          Stroke="{DynamicResource ThemeBrush79684F}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
       </Grid>
      </Border>
      <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-4" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DateFrame" Property="BorderBrush" Value="{DynamicResource ThemeBrushDBB779}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DateFrame" Property="BorderBrush" Value="{DynamicResource ThemeBrushCE8B24}"/></Trigger>
      <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="DateFrame" Property="BorderBrush" Value="{DynamicResource ThemeBrushCE8B24}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DateRoot" Property="Opacity" Value="0.48"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ContextMenu">
  <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ContextMenu">
     <Border x:Name="MenuSurface" Margin="4,4,7,8" CornerRadius="12" SnapsToDevicePixels="True">
      <Grid>
       <Control Style="{StaticResource FrostedBackdrop}"/>
       <ItemsPresenter Margin="6" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </Grid>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="Padding" Value="13,8,18,8"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="MenuItem">
     <Border x:Name="MenuRow" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="8">
      <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource ThemeBrushFFF0CB}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#9A8870"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="PanningMode" Value="VerticalOnly"/></Style>
 <Style TargetType="Separator"><Setter Property="Background" Value="{StaticResource Line}"/><Setter Property="Height" Value="1"/><Setter Property="Margin" Value="0,8"/></Style>
 <Style x:Key="AssistantInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Grid Background="Transparent"><ScrollViewer x:Name="PART_ContentHost"/>
    <TextBlock x:Name="Hint" Text="问问便单小助手…" Foreground="{StaticResource Muted}" Opacity=".72" VerticalAlignment="Top" Margin="2,1,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AssistantSend" TargetType="Button" BasedOn="{StaticResource Primary}">
  <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Face" CornerRadius="18" Background="{TemplateBinding Background}"><TextBlock Text="↑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".42"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".85"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Ink}"/><Setter TargetName="Face" Property="BorderThickness" Value="1"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
